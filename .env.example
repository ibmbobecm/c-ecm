# ============================================
# C-ECM — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env — only .env.example goes to git
# ============================================

# ── Backend Core ──────────────────────────────
FD_DATA_DIR=./data
FD_LOCAL_STORAGE_DIR=./local_storage

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# (do not put the real value here)
FD_JWT_ALGO=HS256
FD_JWT_EXPIRE_MINUTES=480

# ── AI / LLM Integration ──────────────────────
# Provider: "openai" | "ollama" | "none"
FD_AI_PROVIDER=none
FD_AI_MODEL=gpt-4o-mini

# OpenAI (leave blank if using Ollama or none)
OPENAI_API_KEY=

# Ollama (leave blank if using OpenAI)
FD_OLLAMA_URL=http://localhost:11434

# ── OAuth App Registrations ───────────────────
# Google Drive
FD_GOOGLE_CLIENT_ID=
FD_GOOGLE_CLIENT_SECRET=

# Microsoft 365 / SharePoint / OneDrive
FD_MS_CLIENT_ID=
FD_MS_CLIENT_SECRET=
FD_MS_TENANT=common

# Box
FD_BOX_CLIENT_ID=
FD_BOX_CLIENT_SECRET=

# ── IBM FileNet Content Engine ────────────────
# (only needed if connecting to FileNet)
FD_FILENET_WSDL=

# ── IBM Cloud Object Storage ──────────────────
# (only needed if connecting to IBM COS)
FD_IBM_COS_REGION=

# ── Upload Limits ─────────────────────────────
FD_MAX_UPLOAD_MB=100

# ── CORS / OAuth Redirect ─────────────────────
FD_OAUTH_REDIRECT_BASE=http://localhost:8000
