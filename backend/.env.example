# Copy this file to .env and fill in whichever backends you're connecting.
# .env is git-ignored — plaintext locally is the same stance the rest of
# this app takes (FileNet's admin/admin, local disk's account), flagged for
# a real secrets vault later, not something to expose over a network as-is.

# --- Alfresco ---
# Just needs a running instance + a valid login — no OAuth app to register.
FD_ALFRESCO_BASE_URL=

# --- Google Drive ---
# console.cloud.google.com -> enable "Google Drive API" -> OAuth consent
# screen -> Credentials -> Create OAuth client ID (Web application) ->
# Authorized redirect URI: http://127.0.0.1:8020/connections/oauth/google_drive/callback
# (replace 127.0.0.1 with FD_OAUTH_REDIRECT_BASE's host below if you set one)
FD_GOOGLE_CLIENT_ID=
FD_GOOGLE_CLIENT_SECRET=

# --- Microsoft 365 (OneDrive + SharePoint via Graph) ---
# portal.azure.com -> Azure Active Directory -> App registrations -> New
# registration -> Redirect URI (Web):
#   http://127.0.0.1:8020/connections/oauth/onedrive_sharepoint/callback
# API permissions (delegated, Microsoft Graph): Files.ReadWrite, User.Read,
# offline_access -> Certificates & secrets -> New client secret.
FD_MS_CLIENT_ID=
FD_MS_CLIENT_SECRET=
FD_MS_TENANT=common

# --- Box ---
# account.box.com/developers/console -> Create New App -> Custom App ->
# User Authentication (OAuth 2.0) -> Redirect URI:
#   http://127.0.0.1:8020/connections/oauth/box/callback
# Scopes: Read and write all files and folders.
FD_BOX_CLIENT_ID=
FD_BOX_CLIENT_SECRET=

# --- OAuth redirect base ---
# The base URL Google/Microsoft/Box redirect back to after consent — must
# be reachable from whatever device the user is signing in on, not just the
# server itself. Defaults to http://127.0.0.1:8020, which only works when
# you're on the same machine as the backend. If you sign in from another
# device on the LAN, set this to the server's LAN IP or hostname instead,
# e.g. http://192.168.2.41:8020, and register that exact URL (with each
# provider's callback path above) in each provider's developer console.
FD_OAUTH_REDIRECT_BASE=http://127.0.0.1:8020

# --- IBM i (AS/400 / iSeries) ---
# No global credentials needed here -- hostname, port, IFS root, and
# (currently unimplemented) DB2/CMOD settings are all supplied per-connection
# in the UI. Only the IFS mode is actually implemented; see
# app/storage_providers/ibmi_provider.py's module docstring.
# Requires: pip install paramiko (commented out in requirements.txt --
# uncomment or install manually before connecting an IBM i backend).

# --- IBM Z (z/OS Mainframe) ---
# No global credentials needed here either -- z/OSMF URL, USS root, an
# optional dataset high-level qualifier, and an optional CMOD REST URL are
# all supplied per-connection in the UI. Uses `requests`, already a hard
# dependency, so no extra install needed. See
# app/storage_providers/ibmz_provider.py's module docstring for what's
# implemented (USS + read-only dataset browsing) vs. best-effort/unverified
# (CMOD).

# --- AI backend ---
# The active backend and all IBM Watson credentials below can also be set
# (or changed without restarting) via Admin Settings in the UI once the
# server is running -- these env vars are only the fallback for anyone who
# hasn't opened that panel yet, and are read once at startup either way.
# FD_AI_BACKEND=none   # none | openai | ollama | watsonx | watson_nlu | watson_disco

# OpenAI (or any OpenAI-compatible API) -- UI-configurable only via env, not Admin Settings
# FD_AI_API_KEY=sk-...
# FD_AI_BASE_URL=https://api.openai.com/v1
# FD_AI_MODEL=gpt-4o-mini

# Local Ollama -- UI-configurable only via env, not Admin Settings
# FD_OLLAMA_URL=http://localhost:11434
# FD_OLLAMA_MODEL=llama3

# IBM watsonx.ai (summaries, metadata suggestions, Q&A, generative fallback for Discovery)
# IBM_CLOUD_API_KEY=<IBM Cloud API key>
# WATSONX_PROJECT_ID=<watsonx.ai project ID>
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL=ibm/granite-13b-chat-v2

# IBM Watson NLU (document classification via categories/keywords/entities)
# WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com/instances/<id>
# WATSON_NLU_APIKEY=<Watson NLU instance API key>

# IBM Watson Discovery (deep search + passage-based Q&A across a corpus;
# pair with watsonx.ai above for a generative answer over the passages)
# WATSON_DISCO_URL=https://api.us-south.discovery.watson.cloud.ibm.com/instances/<id>
# WATSON_DISCO_APIKEY=<Watson Discovery instance API key>
# WATSON_DISCO_PROJECT_ID=<Watson Discovery project ID>
