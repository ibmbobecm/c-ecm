# Copy to deploy/.env and fill in. Loaded by docker-compose.yml via
# env_file: .env for the backend service; FD_DB_* used directly by
# docker-compose.yml itself for the postgres service too.
# This file is git-ignored — treat deploy/.env itself as a secret.

# --- Required ---

# The domain/IP this deployment is reached at, INCLUDING the /api suffix
# (nginx.conf proxies /api/ to the backend) — e.g. https://ecm.example.com/api
# or, with no domain yet, http://<server-ip>/api. Anyone registering an
# OAuth app (Google/Microsoft/Box) or a SAML IdP against this deployment
# must use this exact value's callback URLs (see backend/.env.example's
# per-provider notes for the exact callback path each one needs) — get
# this right before registering anything with an external provider.
FD_OAUTH_REDIRECT_BASE=http://CHANGE-ME/api

# This app's own login (not any connected backend's) -- change these from
# the defaults before exposing this deployment beyond localhost.
FD_APP_USERNAME=admin
FD_APP_PASSWORD=CHANGE-ME

# The app's own control-plane database password (see deploy/docker-compose.yml
# -- used for both the postgres container and the backend's connection to it).
FD_DB_PASSWORD=CHANGE-ME
# FD_DB_NAME=cecm
# FD_DB_USER=cecm

# --- Optional ---

# Which host port nginx listens on (put a real reverse proxy/load balancer
# with TLS in front of this in production -- see deploy/README.md).
# HTTP_PORT=80

# Everything from backend/.env.example also applies here (Google/Microsoft/
# Box/Dropbox/Laserfiche OAuth apps, AI provider credentials, SAML IdP
# details, DocuSign, ...) -- copy in whichever of those you need; none are
# required for the app to start.
